{
  "name": "dsh-external-agents",
  "description": "External Agents control plane for DeepSeek Harness Product Workers",
  "version": "0.2.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "docs/**/*.md",
    "skills/**/SKILL.md",
    "README.md",
    "README.zh.md",
    "CONTEXT.md"
  ],
  "scripts": {
    "bundle": "tsdown",
    "build": "tsc -p tsconfig.json && tsdown",
    "test": "vitest run",
    "pack:check": "node scripts/check-pack.mjs",
    "check": "pnpm run build && pnpm run test && pnpm run pack:check"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOirBRight/dsh-external-agents.git"
  },
  "homepage": "https://github.com/NOirBRight/dsh-external-agents#readme",
  "dsh": {
    "bundle": {
